---
import { STORE } from '../config';

const benefits = [
  {
    title: 'Envíos a todo el país',
    text: 'Coordinamos el despacho por WhatsApp',
    icon: 'truck',
  },
  {
    title: 'Retiro en Mendoza',
    text: STORE.address,
    icon: 'store',
  },
  {
    title: 'Asesoramiento personalizado',
    text: 'Te ayudamos a elegir tus insumos',
    icon: 'chat',
  },
  {
    title: 'Transferencia y efectivo',
    text: 'También aceptamos otros medios',
    icon: 'card',
  },
  {
    title: 'Kits para empezar',
    text: 'Todo listo para tu primer proyecto',
    icon: 'gift',
  },
];
---

<section class="border-y border-border bg-white">
  <div class="container-page grid grid-cols-2 gap-x-4 gap-y-6 py-8 md:grid-cols-3 lg:grid-cols-5">
    {
      benefits.map((b) => (
        <div class="flex items-start gap-3">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-brand-secondary-tint text-brand-secondary">
            {b.icon === 'truck' && (
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7z" /><circle cx="7" cy="18" r="1.6" /><circle cx="17.5" cy="18" r="1.6" /></svg>
            )}
            {b.icon === 'store' && (
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h16v10H4z" /><path d="M3 9l2-5h14l2 5" /><path d="M9 19v-5h6v5" /></svg>
            )}
            {b.icon === 'chat' && (
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.5 7.2L4 21l1.8-4.5A8 8 0 1 1 21 12Z" /></svg>
            )}
            {b.icon === 'card' && (
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 10h18" /></svg>
            )}
            {b.icon === 'gift' && (
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v9H4v-9M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 1 1 0-5C11 2 12 7 12 7ZM12 7h4.5a2.5 2.5 0 1 0 0-5C13 2 12 7 12 7Z" /></svg>
            )}
          </span>
          <div>
            <p class="text-sm font-bold leading-tight">{b.title}</p>
            <p class="mt-0.5 text-xs text-muted">{b.text}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
