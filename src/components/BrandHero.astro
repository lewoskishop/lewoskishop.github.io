---
import { STORE } from '../config';

const blobs = [
  { top: '10%', left: '6%', size: 120, color: '#e6d1b9', opacity: 0.55 },
  { bottom: '12%', left: '38%', size: 70, color: '#ac7d59', opacity: 0.18 },
  { top: '18%', right: '40%', size: 54, color: '#40251b', opacity: 0.08 },
  { bottom: '8%', right: '5%', size: 150, color: '#e6d1b9', opacity: 0.45 },
];
---

<section class="container-page pt-8">
  <div
    class="relative overflow-hidden rounded-[var(--radius-xl)] bg-gradient-to-br from-[#f7efe5] via-white to-[#f0e4d6] px-6 py-10 sm:px-12 sm:py-14"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      {
        blobs.map((b) => (
          <span
            class="absolute rounded-full blur-2xl"
            style={`top:${b.top ?? 'auto'};bottom:${b.bottom ?? 'auto'};left:${b.left ?? 'auto'};right:${b.right ?? 'auto'};width:${b.size}px;height:${b.size}px;background:${b.color};opacity:${b.opacity}`}
          />
        ))
      }
    </div>

    <div class="relative grid items-center gap-10 lg:grid-cols-2">
      <div>
        <span class="pill bg-brand-aqua text-brand-ink">
          Insumos para emprendedores
        </span>

        <h1 class="mt-4 text-5xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl">
          <span class="text-foreground">Lewoski</span>{' '}
          <span class="text-brand-secondary">Shop</span>
        </h1>

        <p class="mt-4 max-w-lg text-lg font-semibold text-foreground">{STORE.tagline}</p>
        <p class="mt-2 max-w-lg text-base text-muted">{STORE.description}</p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="/productos/" class="btn-cta px-9 py-4 text-base">Ver productos</a>
          <a href="/categorias/" class="btn-outline px-7 py-4 text-base">Ver categorías</a>
        </div>
      </div>

      <div class="flex justify-center lg:justify-end">
        <div class="relative grid h-56 w-56 place-items-center rounded-full bg-white/70 shadow-sm ring-1 ring-border sm:h-72 sm:w-72">
          <img
            src="/images/logo-lewoski.webp"
            alt="LewoskiShop"
            class="h-40 w-40 object-contain sm:h-52 sm:w-52"
            width="466"
            height="320"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>
