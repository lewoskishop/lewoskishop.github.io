---
import { getCollection } from 'astro:content';
import ProductCard from './ProductCard.astro';
import { normalize, slugifyCategory } from '../lib/catalog';
import { buildTaxonomy, toTaxable } from '../lib/taxonomy';

interface Props {
  title?: string;
  subtitle?: string;
}

const { title = 'Productos', subtitle } = Astro.props;

const products = (await getCollection('products')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name, 'es'),
);

/* Las categorías salen del catálogo. */
const usedCategories = buildTaxonomy(products.map(toTaxable), 'category');
---

<section class="container-page py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-extrabold tracking-tight">{title}</h1>
    {subtitle && <p class="mt-1 text-sm text-muted">{subtitle}</p>}
    <p class="mt-2 text-sm text-muted"><span data-result-count>{products.length}</span> productos disponibles</p>
  </div>

  <div class="mb-6 flex flex-col gap-4 rounded-[var(--radius-xl)] border border-border bg-white p-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex flex-wrap gap-2">
      <label class="sr-only" for="filter-category">Categoría</label>
      <select id="filter-category" data-filter-category class="input max-w-[16rem] py-2">
        <option value="">Todas las categorías</option>
        {usedCategories.map((c) => <option value={c.slug}>{c.name}</option>)}
      </select>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4" data-product-grid>
    {
      products.map((product) => (
        <div
          data-product-item
          data-category={slugifyCategory(product.data.category)}
          data-text={normalize([product.data.name, product.data.category, ...product.data.tags].join(' '))}
        >
          <ProductCard product={product} eager />
        </div>
      ))
    }
  </div>

  <p data-empty-filter class="hidden py-16 text-center text-muted">
    No hay productos con esos filtros. Probá sacando alguno.
  </p>
</section>

<script>
  import { matchesCategory, slugifyCategory } from '../lib/catalog';

  const grid = document.querySelector<HTMLElement>('[data-product-grid]');
  if (grid) {
    const items = Array.from(grid.querySelectorAll<HTMLElement>('[data-product-item]'));
    const categorySelect = document.querySelector<HTMLSelectElement>('[data-filter-category]');
    const countEl = document.querySelector<HTMLElement>('[data-result-count]');
    const emptyEl = document.querySelector<HTMLElement>('[data-empty-filter]');

    const normalize = (v: string) =>
      v
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();

    const state = { category: '', q: '' };

    const params = new URLSearchParams(location.search);
    if (params.get('cat')) state.category = slugifyCategory(params.get('cat') ?? '');
    if (params.get('q')) state.q = params.get('q') ?? '';

    function sync(): void {
      if (categorySelect) categorySelect.value = state.category;
    }

    function apply(): void {
      const q = normalize(state.q);
      let visible = 0;
      items.forEach((item) => {
        const okCategory = matchesCategory(item.dataset.category ?? '', state.category);
        const okQuery = !q || (item.dataset.text ?? '').includes(q);
        const show = okCategory && okQuery;
        item.classList.toggle('hidden', !show);
        if (show) visible++;
      });
      if (countEl) countEl.textContent = String(visible);
      emptyEl?.classList.toggle('hidden', visible > 0);
    }

    categorySelect?.addEventListener('change', () => {
      state.category = categorySelect.value;
      apply();
    });

    sync();
    apply();
  }
</script>
